# import-linter configuration (P1) — dispatch binding: import-linter for the
# layers contract, NOT a hand-rolled AST audit. Run:
#     PYTHONPATH=/opt/data/plugins lint-imports
# (parent dir must be importable — grimp locates the package through sys.path).
#
# NOTE (R76-P4-S2, measured by the architect at e846ae9 — re-measure, do not re-derive):
#   `type = layers` checks TRANSITIVE routes, not direct imports, and has no
#   `allow_indirect_imports` field (import-linter 2.15, contracts/layers.py).
#   Declared on this tree at e846ae9 it reports 11 illegal pairs / 45 routes:
#   hermes_router/__init__.py (the hub) imports api.* (l.44-49) and
#   gate.registration (l.54), and 29 source modules import the hub -> 29
#   distinct entry edges (re-measured at 7388ab2; the earlier "32 entry
#   edges", "238 sites in 37 files" and "31 of 43 route objects" figures did
#   not reproduce and are withdrawn). With BOTH true upward edges exempted
#   STILL broken (11 pairs / 38 routes). Neutralising the hub entirely
#   (all 58 hub-involved edges) still leaves 4 illegal pairs / 5 routes
#   through top-level facility modules. A transitive ladder is not
#   reachable by config, and not reachable by hub surgery alone.
#   The ladder therefore ships as five DIRECT-edge `forbidden` contracts with
#   `allow_indirect_imports = True` (without the flag, `forbidden` checks
#   indirect routes too and 4 of the 5 fail on the untouched tree).
#   Re-measured at 03b0a36 before this slice landed: 92 modules / 320 edges and
#   exactly SEVEN direct upward edges (6 gate.registration -> api.*,
#   1 passes.dispatcher_pre -> api.router_tools); features/lanes/core direct 0.
#
# Active NOW:
[importlinter]
root_packages =
    hermes_router
include_external_packages = True

[importlinter:contract:core-purity]
name = core/ must not import other hermes_router modules (L0)
type = forbidden
source_modules = hermes_router.core
forbidden_modules =
    hermes_router,
    hermes_router.anchor_chain,
    hermes_router.anchor_exec,
    hermes_router.benchmarks,
    hermes_router.bypass_watch,
    hermes_router.classifier,
    hermes_router.commands,
    hermes_router.commands_config,
    hermes_router.commands_diag,
    hermes_router.commands_runtime,
    hermes_router.complexity,
    hermes_router.completion_audit,
    hermes_router.config_writer,
    hermes_router.decision,
    hermes_router.decision_head,
    hermes_router.decision_midturn,
    hermes_router.decision_miner,
    hermes_router.debug_banner,
    hermes_router.dispatcher_knobs,
    hermes_router.dispatcher_post,
    hermes_router.dispatcher_pre,
    hermes_router.flinch_reason,
    hermes_router.frames,
    hermes_router.intent_classifier,
    hermes_router.method_card,
    hermes_router.persona_card,
    hermes_router.provider_prices,
    hermes_router.provenance_footer,
    hermes_router.reflex,
    hermes_router.refusal_doctrine,
    hermes_router.render_inbox,
    hermes_router.render_payload,
    hermes_router.risk,
    hermes_router.route_gate,
    hermes_router.router,
    hermes_router.router_core,
    hermes_router.router_tools,
    hermes_router.semantic_classifier,
    hermes_router.suggestions
# Known function-local late-binds moved INTO core unchanged at P1 (they existed
# before the move to break import cycles; documented carry set, must only
# shrink). ignore list is version-controlled.
#
# R76-P4-S1: entries are `module -> module`. The previous form put a SYMBOL in
# the module position (e.g. `core.routing_caps.router_tools`), so import-linter
# matched nothing, exited 1 with "No matches for ignored import …" and printed
# no contract report at all. Each entry below is grep-proofed against a live
# function-local import edge; an entry with no live edge is a lie and is deleted.
ignore_imports =
    hermes_router.core.canonical -> hermes_router.persona_card
    hermes_router.core.usage_ledger -> hermes_router.anchor_chain
    hermes_router.core.usage_ledger -> hermes_router.provider_prices
    hermes_router.core.routing_caps -> hermes_router.anchor_chain
    hermes_router.core.routing_caps -> hermes_router.debug_banner
    hermes_router.core.decisions -> hermes_router.suggestions
    # --- root-package edges (R76-P4-S1) ------------------------------------
    # These two imports name a symbol that is NOT a submodule of `hermes_router`
    # at graph level, so grimp records the edge against the package root and the
    # pair cannot be expressed as `module -> module` against the real module.
    #
    #   core/routing_caps.py:422   `from .. import router_tools`
    #       router_tools lives at hermes_router/api/router_tools.py and is only
    #       reachable through the re-export at hermes_router/__init__.py:49.
    #       This is the SAME import the pre-S1 entry
    #       `core.routing_caps.router_tools -> hermes_router.router_tools` meant,
    #       re-pointed at the edge that actually exists. Rename, not an addition.
    #
    #   core/telemetry.py:69       `from .core import config_access`
    #       Resolves to hermes_router.core.core (no such module), so the import
    #       is already dead at runtime and always falls through its except. The
    #       graph edge lands on the root. ONE new exemption, declared as debt:
    #       the honest fix is `from . import config_access`, which would ENABLE a
    #       config read path that is dead today — a behaviour change, therefore
    #       out of S1 and out of scope for a guard slice.
    #
    # Both holes are bounded to the root package name for these two modules;
    # every direct core -> hermes_router.<submodule> edge is still caught.
    hermes_router.core.routing_caps -> hermes_router
    hermes_router.core.telemetry -> hermes_router

[importlinter:contract:core-no-cli]
name = core/ must not import hermes_cli (except the config_access adapter)
type = forbidden
source_modules = hermes_router.core
forbidden_modules = hermes_cli
# R76-P4-S1: grimp records external imports at the top-level package it can
# resolve (`hermes_cli`), not the submodule the code spells (`hermes_cli.config`),
# so the exemption must name `hermes_cli` or it matches no live edge. The
# exemption's intent — config_access is the ONE adapter allowed to read config —
# is unchanged; only the module form is repaired.
ignore_imports =
    hermes_router.core.config_access -> hermes_cli

# --- R76-P4-S2: the ladder as five DIRECT-edge contracts ----------------------
# Measured, not aspirational: `allow_indirect_imports = True` is what makes these
# check the seven direct edges only (see the NOTE at the top of this file for why
# a `type = layers` contract cannot express this tree). Descendants of each
# source/forbidden module are included by import-linter's own semantics, so
# `hermes_router.gate` covers gate.registration and gate.orchestration.
#
# Two exemptions, both live direct edges proven by the S2 liveness mutations:
#   gate.registration -> api.{commands, commands_config, commands_diag,
#                              commands_runtime, config_writer, router_tools}
#                                          the composition root's 6 handler binds
#   passes.dispatcher_pre -> api.router_tools   one function-local late-bind
# Every other direct upward edge is illegal. No third exemption exists.
#
# R76-P4-S2b: the gate exemption is SIX PAIR-EXACT entries, not
# `hermes_router.api.*`. The wildcard absorbed every present and future api
# submodule: adding `api/newthing.py` + `from ..api import newthing` left the
# contract KEPT with 7 ignored imports. The intent was always a fixed set of six
# (gate/registration.py:32), so the config now enforces exactly that.

[importlinter:contract:gate-no-api]
name = gate may not import api (direct)
type = forbidden
source_modules = hermes_router.gate
forbidden_modules = hermes_router.api
allow_indirect_imports = True
ignore_imports =
    hermes_router.gate.registration -> hermes_router.api.commands
    hermes_router.gate.registration -> hermes_router.api.commands_config
    hermes_router.gate.registration -> hermes_router.api.commands_diag
    hermes_router.gate.registration -> hermes_router.api.commands_runtime
    hermes_router.gate.registration -> hermes_router.api.config_writer
    hermes_router.gate.registration -> hermes_router.api.router_tools

[importlinter:contract:passes-no-api]
name = passes may not import api (direct)
type = forbidden
source_modules = hermes_router.passes
forbidden_modules = hermes_router.api
allow_indirect_imports = True
ignore_imports =
    hermes_router.passes.dispatcher_pre -> hermes_router.api.router_tools

[importlinter:contract:features-no-upward]
name = features may not import api/gate/passes (direct)
type = forbidden
source_modules = hermes_router.features
forbidden_modules =
    hermes_router.api
    hermes_router.gate
    hermes_router.passes
allow_indirect_imports = True

[importlinter:contract:lanes-no-upward]
name = lanes may not import api/gate/passes/features (direct)
type = forbidden
source_modules = hermes_router.lanes
forbidden_modules =
    hermes_router.api
    hermes_router.gate
    hermes_router.passes
    hermes_router.features
allow_indirect_imports = True

[importlinter:contract:core-no-layers]
name = core may not import api/gate/passes/features/lanes (direct)
type = forbidden
source_modules = hermes_router.core
forbidden_modules =
    hermes_router.api
    hermes_router.gate
    hermes_router.passes
    hermes_router.features
    hermes_router.lanes
allow_indirect_imports = True

# --- R76-P4-S2b: hub-spelling blind spot ------------------------------------
# The five contracts above name layer PACKAGES. `from ... import router_tools`
# in a features/lanes module is a direct upward import of api.router_tools at
# runtime, but grimp records the edge against the ROOT package (`hermes_router`,
# because no top-level module of that name exists), so none of the five saw it
# -- both probes stayed KEPT on the aa1f846 tree.
#
# Shape notes (both forced by import-linter 2.15, not preference):
#   * `as_packages = False` -- with the default True, every source/forbidden
#     pair that NESTS is skipped (contracts/forbidden.py::_modules_overlap), and
#     features/lanes live inside hermes_router, so the contract would be a no-op.
#   * sources are ENUMERATED -- with as_packages=False only the named module is
#     checked, and a wildcard expression (`hermes_router.features.*`) is not
#     expanded by this version. Adding a module under features/ or lanes/ means
#     adding it here; tests/test_import_guard_liveness.py fails if one is missing.
# Current legit root edges are the four facility modules below (7 sites).
[importlinter:contract:features-lanes-no-root]
name = features/lanes may not import the root package hermes_router (direct)
type = forbidden
source_modules =
    hermes_router.features
    hermes_router.features.banners
    hermes_router.features.banners.kinds
    hermes_router.features.banners.lifecycle
    hermes_router.features.banners.turn_record
    hermes_router.features.detection
    hermes_router.features.detection.declaration
    hermes_router.features.detection.denial_class
    hermes_router.features.detection.normalise
    hermes_router.features.detection.semantic_judge
    hermes_router.features.detection.structural
    hermes_router.features.detection.unknown_route_gate
    hermes_router.features.envelope
    hermes_router.features.envelope.unified
    hermes_router.features.patterns
    hermes_router.features.patterns.engine
    hermes_router.lanes
    hermes_router.lanes.builtins
    hermes_router.lanes.registry
forbidden_modules = hermes_router
allow_indirect_imports = True
as_packages = False
ignore_imports =
    hermes_router.features.banners.lifecycle -> hermes_router.debug_banner
    hermes_router.features.banners.lifecycle -> hermes_router.render_inbox
    hermes_router.features.banners.lifecycle -> hermes_router.advisory_consumption
    hermes_router.features.detection.semantic_judge -> hermes_router.dispatcher_knobs
    hermes_router.features.detection.semantic_judge -> hermes_router.advisory_consumption
